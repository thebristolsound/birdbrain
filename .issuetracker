# Integration with Issue Tracker
#
# (note that '\' need to be escaped).

[issuetracker "Github"]
  regex = "#(\\d+)"
  url = "https://github.com/thebristolsound/repository/issues/$1"

[issuetracker "Linear"]
  regex = "MOM-(\\d+)"
  url = "https://linear.app/momentaryarchitecture/issue/MOM-$1"

[issuetracker "Sample Jira Multiproject Rule"]
  regex = "(WIT|INNOVA)-(\\d+)"
  url = "https://jira.yourcompany.com/browse/$1-$2"
