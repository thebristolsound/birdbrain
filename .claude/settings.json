{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "includeGitInstructions": false,
  "outputStyle": "Plain Technical",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/skills/post-commit-message/scripts/check.sh"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/skills/post-pr-body/scripts/check.sh"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/skills/post-comment/scripts/check.sh"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/guard-maintainer-labels.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/vale-prose.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm rebuild:electron)",
      "Bash(pnpm lint)",
      "Bash(pnpm test)",
      "Bash(pnpm test:coverage)",
      "Bash(pnpm test:e2e)",
      "Bash(pnpm build:*)",
      "Bash(pnpm build:extension)",
      "Bash(pnpm build:verifier)",
      "Bash(npx tsc --noEmit -p tsconfig.node.json)",
      "Bash(npx tsc --noEmit -p tsconfig.web.json)",
      "Bash(npx tsc --noEmit -p extension/tsconfig.json)",
      "Bash(git status:*)",
      "Bash(git diff)",
      "Bash(git diff --stat)",
      "Bash(git diff --cached)",
      "Bash(git diff --name-only)",
      "Bash(git log --oneline)",
      "Bash(git log --oneline -20)",
      "Bash(git log -5)",
      "Bash(git show)",
      "Bash(git show --stat)",
      "Bash(git show HEAD)",
      "Bash(git blame:*)",
      "Bash(gh api repos/thebristolsound/birdbrain/:*)",
      "Bash(gh api /user:*)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm typecheck *)",
      "Bash(pnpm coverage:diff)",
      "Bash(pnpm coverage:diff *)",
      "Bash(pnpm test tests/*)",
      "Bash(vale *)",
      "Bash(npx prettier --check *)"
    ]
  },
  "extraKnownMarketplaces": {
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills"
      }
    },
    "knowledge-work-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/knowledge-work-plugins"
      }
    }
  },
  "enabledPlugins": {
    "mattpocock-skills@mattpocock": true,
    "design@knowledge-work-plugins": true
  }
}
