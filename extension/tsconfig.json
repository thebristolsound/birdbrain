{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "outDir": "./dist",
    "rootDir": "..",
    "lib": ["ES2022", "DOM"],
    "types": ["chrome", "node", "vite/client"],
    "paths": {
      "@extension/*": ["./src/*"],
      "@shared/*": ["../src/shared/*"]
    }
  },
  "include": ["src/**/*"]
}
