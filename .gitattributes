# Frozen evidence-package fixtures are byte-exact known-answer material: any
# EOL conversion on checkout changes hashes and breaks the chain they pin.
tests/shared/verify/fixtures/** -text
# The golden thumbnail tests in tests/main/services/thumbnails.test.ts hash these inputs.
tests/main/services/fixtures/thumbnails/*.png -text
# The decoder digest pins in tests/main/services/mhtmlDecoder.test.ts hash the fixture
# as stored, CRLF line breaks included.
tests/main/services/fixtures/*.mhtml -text
# The export known answers in tests/main/services/exportKnownAnswer.test.ts pin packages that
# enclose these public keys byte for byte, and sign with a digest of their text.
tests/fixtures/export-known-answer/*.pem -text
# tests/main/services/captureRowKnownAnswers.test.ts compares this fixture byte for byte,
# so a line-ending conversion on checkout must not touch it.
tests/fixtures/captureRow/** -text
