{
  "type": "object",
  "additionalProperties": false,
  "required": ["findings", "not_checked", "source_review_complete", "runtime_limitations", "contract_version"],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "file", "line", "plain", "detail", "failure_scenario"],
        "properties": {
          "severity": { "type": "string", "enum": ["BLOCKING", "NON-BLOCKING"] },
          "file": { "type": "string" },
          "line": { "type": "integer" },
          "plain": { "type": "string" },
          "detail": { "type": "string" },
          "failure_scenario": { "type": "string" }
        }
      }
    },
    "not_checked": {
      "type": "array", "maxItems": 10,
      "items": { "type": "string", "minLength": 1, "maxLength": 600 }
    },
    "source_review_complete": { "type": "boolean" },
    "runtime_limitations": {
      "type": "array", "maxItems": 10,
      "items": { "type": "string", "minLength": 1, "maxLength": 600 }
    },
    "contract_version": { "type": "integer", "enum": [2] }
  }
}
