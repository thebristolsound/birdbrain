{
  "name": "birdbrain",
  "version": "1.0.1-beta.9",
  "description": "Open source web investigation & capture tool",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@10.28.2",
  "author": "Matt Donovan",
  "license": "MIT",
  "homepage": "https://github.com/thebristolsound/birdbrain",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "postinstall": "node scripts/rebuild-native.mjs",
    "rebuild:electron": "node scripts/rebuild-native.mjs",
    "build:extension": "vite build --config extension/vite.config.ts && cross-env BUILD_TARGET=content vite build --config extension/vite.config.ts",
    "dev:extension": "vite build --config extension/vite.config.ts --watch",
    "test": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs run",
    "test:watch": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs",
    "test:coverage": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs run --coverage",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"extension/**/*.{ts,tsx}\"",
    "pretest:e2e": "pnpm build",
    "test:e2e": "npx playwright test",
    "test:e2e:debug": "npx playwright test --debug",
    "pretest:e2e:debug": "pnpm build",
    "package": "pnpm build:extension && electron-vite build && electron-builder --publish never",
    "package:win": "pnpm build:extension && electron-vite build && electron-builder --win --publish never",
    "package:mac": "pnpm build:extension && electron-vite build && electron-builder --mac --publish never",
    "package:linux": "pnpm build:extension && electron-vite build && electron-builder --linux --publish never"
  },
  "build": {
    "appId": "com.birdbrain.app",
    "productName": "Birdbrain",
    "icon": "resources/icon.png",
    "directories": {
      "output": "dist"
    },
    "asarUnpack": [
      "**/node_modules/sharp/**",
      "**/node_modules/@img/**"
    ],
    "extraResources": [
      {
        "from": "extension/dist",
        "to": "extension",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "resources/icons",
      "category": "Utility",
      "maintainer": "Matt Donovan <thebristolsound@users.noreply.github.com>"
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild",
      "msw",
      "sharp"
    ]
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/plus-jakarta-sans": "^5.2.8",
    "@hono/node-server": "^1.19.13",
    "@hono/zod-validator": "^0.4.3",
    "@peculiar/asn1-cms": "^2.7.0",
    "@peculiar/asn1-schema": "^2.7.0",
    "@peculiar/asn1-tsp": "^2.7.0",
    "@peculiar/asn1-x509": "^2.7.0",
    "@tanstack/react-query": "^5.96.2",
    "@tanstack/react-router": "^1.168.10",
    "better-sqlite3": "^12.8.0",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.12.14",
    "ioc-extractor": "^8.1.7",
    "konva": "^10.2.5",
    "lucide-react": "^0.577.0",
    "motion": "^12.38.0",
    "radix-ui": "^1.4.3",
    "react-konva": "^19.2.3",
    "react-markdown": "^10.1.0",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.5.0",
    "tldts": "^7.0.28",
    "use-image": "^1.1.4",
    "uuid": "^11.1.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-query-devtools": "^5.96.2",
    "@tanstack/router-devtools": "^1.166.11",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/chrome": "^0.1.39",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.4",
    "cross-env": "^10.1.0",
    "electron": "^39.8.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.1.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.8.9",
    "jsdom": "^29.1.1",
    "node-gyp": "^12.1.0",
    "prettier": "^3.8.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "shadcn": "^4.5.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^6.4.2",
    "vitest": "^3.2.4"
  }
}
